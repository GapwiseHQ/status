---
const commentsEndpoint = "/_data/history";
const commentsFallbackEndpoint = "https://api.github.com/repos/GapwiseHQ/status/issues/1/comments";
---

<section class="gapwise-status-history" data-gapwise-status-history data-comments-endpoint={commentsEndpoint} data-comments-fallback-endpoint={commentsFallbackEndpoint} aria-live="polite">
  <div class="status-history-toolbar">
    <a href="/" class="status-back-link">← Current status</a>
    <span class="monitor-badge">Recorded transitions</span>
  </div>
  <div class="status-stat-grid" data-history-stats>
    <article class="status-stat"><span class="status-stat__label">Incident transitions</span><strong data-history-incidents>—</strong><span class="status-stat__foot">Degraded or outage entries</span></article>
    <article class="status-stat"><span class="status-stat__label">Recoveries</span><strong data-history-recoveries>—</strong><span class="status-stat__foot">Returns to operational</span></article>
    <article class="status-stat"><span class="status-stat__label">Services affected</span><strong data-history-services>—</strong><span class="status-stat__foot">Unique recorded services</span></article>
    <article class="status-stat"><span class="status-stat__label">Recorded changes</span><strong data-history-total>—</strong><span class="status-stat__foot">All machine-readable events</span></article>
  </div>
  <div class="status-history-list" data-history-list><div class="loading-row">Loading recorded history…</div></div>
  <div class="status-disclaimer">This is a transition record, not a continuous uptime ledger. Brief interruptions between hourly checks may not appear, operator-maintained services are recorded when manually updated, and Gapwise does not backfill uptime percentages for periods it did not continuously measure.</div>
</section>

<script is:inline>
const A="<!-- GAPWISE_STATUS_EVENT_START -->",B="<!-- GAPWISE_STATUS_EVENT_END -->",SIZE=100,MAX=20;
const TRUSTED_ASSOCIATIONS = new Set(["OWNER", "MEMBER", "COLLABORATOR"]);
const isTrustedComment = c => Boolean(c && typeof c === "object" && (TRUSTED_ASSOCIATIONS.has(c.author_association) || c.user?.login === "github-actions[bot]" || (c.user?.type === "Bot" && String(c.user?.login||"").startsWith("github-actions"))));
const isValidEvent = e => Boolean(e && typeof e === "object" && e.version === 1 && typeof e.serviceName === "string" && e.serviceName.trim() && ["operational", "degraded", "outage"].includes(e.to) && e.at && !Number.isNaN(new Date(e.at).getTime()));
const esc=v=>String(v??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#039;");
const extract=body=>{const s=body.indexOf(A),e=body.indexOf(B);return s<0||e<=s?null:JSON.parse(body.slice(s+A.length,e).trim())};
const tone=s=>["outage","degraded","operational"].includes(s)?s:"unknown";
const summary=e=>e.to==="operational"?`${e.serviceName} recovered`:e.to==="degraded"?`${e.serviceName} entered degraded performance`:e.to==="outage"?`${e.serviceName} became unavailable`:`${e.serviceName} status changed`;
async function page(endpoints,n){let err;for(const endpoint of endpoints.filter(Boolean)){try{const u=new URL(endpoint,location.origin);u.searchParams.set("per_page",SIZE);u.searchParams.set("page",n);const r=await fetch(u,{headers:{Accept:"application/vnd.github+json"}});if(!r.ok)throw new Error(String(r.status));const x=await r.json();if(!Array.isArray(x))throw new Error("invalid");return x}catch(e){err=e}}throw err}
async function all(endpoints){const out=[];for(let n=1;n<=MAX;n++){const x=await page(endpoints,n);out.push(...x);if(x.length<SIZE)break}return out}
document.querySelectorAll("[data-gapwise-status-history]").forEach(async root=>{const list=root.querySelector("[data-history-list]");try{const comments=await all([root.dataset.commentsEndpoint,root.dataset.commentsFallbackEndpoint]);const events=comments.filter(isTrustedComment).map(c=>{try{return extract(c.body||"")}catch{return null}}).filter(isValidEvent).map(e=>({...e,date:new Date(e.at)})).filter(e=>!Number.isNaN(e.date.getTime())).sort((a,b)=>b.date-a.date);const incidents=events.filter(e=>["degraded","outage"].includes(e.to)),recoveries=events.filter(e=>e.to==="operational"),services=new Set(events.map(e=>e.serviceName));root.querySelector("[data-history-incidents]").textContent=String(incidents.length);root.querySelector("[data-history-recoveries]").textContent=String(recoveries.length);root.querySelector("[data-history-services]").textContent=String(services.size);root.querySelector("[data-history-total]").textContent=String(events.length);if(!events.length){list.innerHTML='<div class="status-history-empty"><span class="status-icon status-icon--operational">✓</span><div><h2>No recorded incidents yet</h2><p>No monitored service has entered a degraded or outage state since this independent status history began.</p></div></div>';return}const monthFmt=new Intl.DateTimeFormat(undefined,{month:"long",year:"numeric"}),dayFmt=new Intl.DateTimeFormat(undefined,{weekday:"short"}),timeFmt=new Intl.DateTimeFormat(undefined,{hour:"numeric",minute:"2-digit",timeZoneName:"short"}),groups=new Map();for(const e of events){const m=monthFmt.format(e.date);if(!groups.has(m))groups.set(m,[]);groups.get(m).push(e)}list.innerHTML=Array.from(groups.entries()).map(([m,es])=>`<section class="status-history-month"><h2>${esc(m)}</h2><div>${es.map(e=>`<article class="status-history-event status-history-event--${tone(e.to)}"><div class="status-history-event__date"><strong>${String(e.date.getDate()).padStart(2,"0")}</strong><span>${esc(dayFmt.format(e.date))}</span></div><div class="status-history-event__bar"></div><div class="status-history-event__content"><h3>${esc(summary(e))}</h3><p>${esc(e.message||`Status changed from ${e.from||"unknown"} to ${e.to||"unknown"}.`)}</p><p>${esc(e.from||"unknown")} → ${esc(e.to||"unknown")}</p></div><time datetime="${esc(e.at)}">${esc(timeFmt.format(e.date))}</time></article>`).join("")}</div></section>`).join("")}catch(e){list.innerHTML='<div class="loading-row loading-row--error">Incident history could not be loaded right now. The current status page remains available.</div>';console.error("Gapwise status history:",e)}});
</script>
